{
  "name": "seneca-openf1-provider",
  "version": "0.0.1",
  "description": "",
  "main": "dist/Openf1.js",
  "type": "commonjs",
  "types": "dist/Openf1.d.ts",
  "description": "Plugin for Openf1 API provider",
  "homepage": "https://github.com/lmscunha/seneca-openf1-provider",
  "keywords": [
    "seneca",
    "openf1"
  ],
  "author": "Leonardo Cunha - leonardocunha.com",
  "repository": {
    "type": "git",
    "url": "git://github.com/lmscunha/seneca-openf1-provider.git"
  },
  "scripts": {
    "prettier": "prettier --write .",
    "test": "node --enable-source-maps --test \"dist-test/**/*.test.js\"",
    "test-some": "node --enable-source-maps --test-name-pattern=\"$TEST_PATTERN\" --test \"dist-test/**/*.test.js\"",
    "watch": "tsc --build src test -w",
    "build": "tsc --build src test",
    "doc": "seneca-doc",
    "clean": "rm -rf dist dist-test node_modules yarn.lock package-lock.json",
    "reset": "npm run clean && npm i && npm run build && npm test",
    "repo-tag": "REPO_VERSION=`node -e \"console.log(require('./package').version)\"` && echo TAG: v$REPO_VERSION && git commit -a -m v$REPO_VERSION && git push && git tag v$REPO_VERSION && git push --tags;",
    "repo-publish": "npm run clean && npm i && npm run repo-publish-quick",
    "repo-publish-quick": "npm run build && npm run test && npm run doc && npm run repo-tag && npm publish --access public --registry https://registry.npmjs.org "
  },
  "license": "MIT",
  "files": [
    "dist",
    "src/**/*.ts",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@hapi/code": "^9.0.3",
    "@seneca/doc": "^8.0.0",
    "@seneca/maintain": "^0.1.0",
    "@seneca/provider": ">=3.1",
    "@types/node": "^25.2.3",
    "gubu": "^9.0.0",
    "prettier": "3.8.1",
    "seneca-msg-test": "^4.1.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@seneca/entity-util": ">=3",
    "gubu": ">=9",
    "seneca": ">=3||>=4.0.0-rc2",
    "seneca-entity": ">=26",
    "seneca-promisify": ">=3"
  }
}
